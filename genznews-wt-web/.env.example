USER_AGENT=GenZNewsAI/0.1 (local article extraction)
REQUEST_TIMEOUT_SECONDS=15
MIN_ARTICLE_CHARS=200
MAX_ARTICLE_CHARS=30000

# Gemini LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase Credentials (Optional for Cloud Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Framework stage (framework_stage/)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
FRAMEWORK_MODEL=gemini-3.8-flash
CLASSIFIER_MODEL=gemini-3.8-flash
DAILY_GENERATION_CAP=50
RUN_LIMIT=20
MIN_SOURCE_CHARS=400
AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_MIN_CONFIDENCE=0.9
AUTO_PUBLISH_NICHES=
IMAGE_POLICY=hotlink
TITLE_JACCARD_MIN=0.5
SIMHASH_MAX_DISTANCE=6
DEDUP_WINDOW_HOURS=72
COST_PER_MTOK_IN=0.10
COST_PER_MTOK_OUT=0.40
# Path to the pipeline's SQLite source database (default: articles.db in the repo root)
STAGE_DB_PATH=articles.db
# Lock file that stops two framework-stage runs overlapping (default: .framework_stage.lock in the repo root)
STAGE_LOCK_PATH=.framework_stage.lock

# OpenAI fallback, used only when Gemini is overloaded (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Seconds between Gemini calls, and the earliest story date to fetch (default: 1st of this month)
GEMINI_DELAY_SECONDS=8
# FETCH_SINCE=2026-10-01
