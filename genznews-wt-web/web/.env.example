# Where stories come from. Required, there is no default.
#   supabase = real published stories from the database
#   fixtures = DEMO data built from output/*.md, never real. Choose it explicitly, only for local demos.
DATA_SOURCE=supabase
# Supabase project URL (Project Settings, API)
SUPABASE_URL=
# Supabase publishable (anon) key, read-only access
SUPABASE_ANON_KEY=
# Public base URL of the site, used for canonical links and the sitemap.
# Inlined at build time: set it before `npm run build`. Unset or invalid falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret that protects POST /api/revalidate. If empty, the endpoint answers 401.
REVALIDATE_SECRET=
# Server console logging of data sources and decisions: 1 on, 0 off.
# Default when empty: on in development, off in production.
DATA_LOG=
